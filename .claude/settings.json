{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Edit(prereg/**)",
      "Write(prereg/**)"
    ],
    "ask": [
      "Bash(pip install:*)",
      "Bash(python -m pip install:*)",
      "Bash(.venv/Scripts/pip install:*)",
      "Bash(.venv/Scripts/python -m pip install:*)",
      "Bash(uv add:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|NotebookEdit",
        "hooks": [{ "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_check.sh\"" }]
      }
    ]
  }
}
